# ============================================================================
#  Copy this file to ".env.local" and fill in your keys.
#  NEVER commit .env.local to git.
# ============================================================================

# ---- Passcode gate ---------------------------------------------------------
# One shared password for the whole app. Leave blank to disable the lock.
# Generate a strong one:  node -e "console.log(crypto.randomUUID())"
APP_PASSCODE=change-me-to-something-long

# ---- Provider API keys -----------------------------------------------------
# At least ONE key is required. Add as many as you have; the router uses
# whichever are present, in the order defined in src/config/models.ts.

# OpenAI - primary tier. NOTE: free tier may train on your data.
OPENAI_API_KEY=

# Google Gemini - your paid key. This is the Privacy Mode provider.
GEMINI_API_KEY=

# NVIDIA NIM - free developer tier, later fallback.
NVIDIA_API_KEY=

# Groq - free tier, fast, last-resort fallback.
GROQ_API_KEY=
